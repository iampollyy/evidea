# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Load into the shell before running migrations or seeds:  set -a && . ./.env && set +a

# Owner connection: used by Alembic migrations, seeds and tests. Never give this to the application.
DATABASE_URL=postgresql://postgres:CHANGE_ME_OWNER_PASSWORD@localhost:5433/evidea

# Password for the login role evidea_app (member of app_write). Used once, when creating the role.
EVIDEA_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Connection used by the application at runtime. Must not be a superuser.
DATABASE_APP_URL=postgresql://evidea_app:CHANGE_ME_APP_PASSWORD@localhost:5433/evidea
