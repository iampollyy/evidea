# Copy to .env and fill in real values. .env is git-ignored and must never be committed.
# Load into the shell before running migrations or seeds:  set -a && . ./.env && set +a

# Password of the PostgreSQL owner (postgres). Used by Docker Compose to create the database.
POSTGRES_PASSWORD=CHANGE_ME_OWNER_PASSWORD

# Owner connection: used by Alembic migrations, seeds and tests. Never give this to the application.
DATABASE_URL=postgresql://postgres:CHANGE_ME_OWNER_PASSWORD@127.0.0.1:5433/evidea

# Password for the login role evidea_app (member of app_write). Used once, when creating the role.
EVIDEA_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# Connection used by the application at runtime. Must not be a superuser.
DATABASE_APP_URL=postgresql://evidea_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:5433/evidea

# --- API (backend/app) -------------------------------------------------------------------
# Secret that signs session cookies. At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set to false only when serving over plain http from a host other than localhost.
COOKIE_SECURE=true
# Origins allowed to send state-changing requests (CSRF protection), JSON list.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8080"]
# Base URL used in invitation emails.
FRONTEND_URL=http://localhost:5173
# Outgoing email. Defaults point to Mailpit (local mail catcher, web UI on :8025).
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=EVIDEA <no-reply@evidea.local>
# Where uploaded photos and avatars are stored.
STORAGE_DIR=./storage
LOG_LEVEL=INFO
LOG_JSON=true

# --- Docker Compose ----------------------------------------------------------------------
# Address of the web app in the browser. Used for CSRF origin checks and invitation links.
PUBLIC_URL=http://localhost:8080
